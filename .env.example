# 任意。設定すると LLM の認証が Claude Code のログインから API キーに切り替わる
ANTHROPIC_API_KEY=

# 任意。インタビューへのフィードバックの保持日数（既定 180。0 で無期限。design-doc R21）
ADP_FEEDBACK_RETENTION_DAYS=

# データ基盤の接続先（いまは duckdb だけ。切り替えの手順は docs/adr/0005-real-data.md）
# ADP_WAREHOUSE=duckdb

# マージされた PR を確かめて自動で反映する間隔（秒。既定 60、0 で自動にしない。#106）
# ADP_AUTO_SYNC_INTERVAL_S=60
