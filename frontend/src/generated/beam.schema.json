{
  "$defs": {
    "Additivity": {
      "description": "足し上げてよいか。単価は non_additive、残高は時間方向に semi_additive。",
      "enum": [
        "additive",
        "semi_additive",
        "non_additive"
      ],
      "title": "Additivity",
      "type": "string"
    },
    "Aggregation": {
      "enum": [
        "sum",
        "count",
        "count_distinct",
        "average",
        "min",
        "max"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "Attribute": {
      "additionalProperties": false,
      "description": "ディメンションの属性。dim のカラムになる。",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "unknown"
        },
        "history_required": {
          "default": false,
          "description": "値の変更履歴が必要か（SCD Type2 の要否。MVP では記録のみ）",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "Availability": {
      "description": "ソースデータで作れるか。",
      "enum": [
        "unknown",
        "available",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "BeamModel": {
      "additionalProperties": false,
      "description": "BEAM 成果物のルート。beam/<name>.yml に保存される。",
      "properties": {
        "schema_version": {
          "default": 1,
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "request": {
          "description": "ユーザーの最初の要求文",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/BusinessEvent"
          },
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricRequest"
          },
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "type": "array"
        },
        "finalized_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "title",
        "request"
      ],
      "title": "BeamModel",
      "type": "object"
    },
    "Bridge": {
      "additionalProperties": false,
      "description": "1 つの出来事に複数の値が付く切り口（多対多）の、値の源泉（ブリッジ。ADR 0010）。\n\n出来事の 1 行に付いた値の数で、加算できる値（金額・件数）を均等に按分した fct を作る（割合の\n列 weight があれば、その割合で按分する）。\nディメンションの fact_key は、この表の値の列（例: raw.order_promotions.promotion_id）にする。",
      "properties": {
        "table": {
          "description": "値の源泉の表（例: raw.order_promotions。1 行が、注文などの 1 件に付いた値 1 つ）",
          "type": "string"
        },
        "event_key": {
          "$ref": "#/$defs/SourceRef",
          "description": "出来事の側で、ブリッジと結ぶ列（例: raw.orders.order_id）。出来事の 1 行から多対一でたどれる列にする"
        },
        "bridge_key": {
          "description": "ブリッジの側で、出来事を指す列（例: order_id）",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ブリッジの側で、値ごとの割合の列（例: share）。出来事ごとの合計で割って重みにする（合計が 0 か、NULL・負の値があれば均等）。無ければ付いた値の数で均等に割る"
        }
      },
      "required": [
        "table",
        "event_key",
        "bridge_key"
      ],
      "title": "Bridge",
      "type": "object"
    },
    "BusinessEvent": {
      "additionalProperties": false,
      "description": "「誰が・何をする」のビジネスイベント。fct 1 つに対応する。",
      "properties": {
        "name": {
          "description": "例: customer_orders_product",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "table_name": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fct テーブル名の名詞部分。粒度を表す複数形（例: order_lines）"
        },
        "label": {
          "description": "例: 顧客が商品を注文する",
          "type": "string"
        },
        "subject": {
          "description": "Who（主語）",
          "type": "string"
        },
        "verb": {
          "description": "動詞",
          "type": "string"
        },
        "object": {
          "description": "What（目的語）",
          "type": "string"
        },
        "story_type": {
          "$ref": "#/$defs/StoryType",
          "default": "discrete"
        },
        "grain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 行が何を表すか（日本語）"
        },
        "grain_keys": {
          "description": "粒度を一意にするキー。縮退ディメンション名または dimension ref",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        },
        "measures": {
          "items": {
            "$ref": "#/$defs/Measure"
          },
          "type": "array"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "type": "array"
        },
        "degenerate_dimensions": {
          "items": {
            "$ref": "#/$defs/DegenerateDimension"
          },
          "type": "array"
        },
        "agg_time_dimension": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "指標を時間で集計するときの When の ref。When が複数あるときは必須"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/EventExample"
          },
          "type": "array"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_tables": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "label",
        "subject",
        "verb",
        "object"
      ],
      "title": "BusinessEvent",
      "type": "object"
    },
    "DegenerateDimension": {
      "additionalProperties": false,
      "description": "dim テーブルを持たない、fct に直接置く識別子（例: 注文番号）。",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "name",
        "label",
        "source"
      ],
      "title": "DegenerateDimension",
      "type": "object"
    },
    "Dimension": {
      "additionalProperties": false,
      "description": "6W のいずれかに対応するディメンション。",
      "properties": {
        "w": {
          "$ref": "#/$defs/W"
        },
        "name": {
          "description": "ディメンション名（例: customer）。dim_<name> になる",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "同じディメンションを複数の役割で使う場合の役割名（例: ship_to）"
        },
        "attributes": {
          "items": {
            "$ref": "#/$defs/Attribute"
          },
          "type": "array"
        },
        "hierarchy": {
          "description": "粗い→細かいの順の属性名（例: region, prefecture）",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        },
        "time_grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeGrain"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When の最小粒度"
        },
        "stage": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "段階を経て進む出来事（evolving）の When の、段階の順番（1 から。例: 注文 1・出荷 2・配達 3）"
        },
        "business_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ディメンション自身のソース上の自然キー。When は不要（カレンダーを生成）"
        },
        "fact_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "イベント側のソースで、このディメンションを指すカラム（例: raw.orders.customer_id、When なら raw.orders.ordered_at）。役割ごとに異なる"
        },
        "bridge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bridge"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 つの出来事に複数の値が付く切り口（例: 1 注文に複数のプロモーション）のとき、値の源泉の表。金額・件数を付いた値の数で按分した、別の出来事（別の table_name）として記録する。1 回ごとの出来事だけ・1 つの出来事に 1 つまで・役割の名前（role）が要る。具体例の金額は、按分する前の元の 1 行の値を書く"
        }
      },
      "required": [
        "w",
        "name",
        "label"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "EventExample": {
      "additionalProperties": false,
      "description": "インタビューで集めた具体例（event story）。unit test の期待値になる。",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExampleKind",
          "default": "typical",
          "description": "具体例の型（typical: 典型 / variant: 別パターン / repeat: 繰り返し / missing: 欠損 / group: グループ）"
        },
        "note": {
          "default": "",
          "description": "典型とどこが違うか（典型なら空でよい）",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "キーは measure 名、縮退ディメンション名、`<dimension ref>.<attribute>`、または When の dimension ref（値は日付・日時の文字列）",
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "title": "EventExample",
      "type": "object"
    },
    "EventMatrix": {
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/MatrixColumn"
          },
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/MatrixRow"
          },
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "EventMatrix",
      "type": "object"
    },
    "ExampleKind": {
      "description": "具体例（event story）の型（#142）。典型の例のほかに、数え方を確かめる例を集める。",
      "enum": [
        "typical",
        "variant",
        "repeat",
        "missing",
        "group"
      ],
      "title": "ExampleKind",
      "type": "string"
    },
    "FactType": {
      "enum": [
        "transaction",
        "periodic_snapshot",
        "accumulating_snapshot"
      ],
      "title": "FactType",
      "type": "string"
    },
    "FilterOperator": {
      "enum": [
        "=",
        "!=",
        "in",
        "not_in"
      ],
      "title": "FilterOperator",
      "type": "string"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "未解決事項。PR 本文に書かれ、data_unavailable は issue も起票される。",
      "properties": {
        "kind": {
          "$ref": "#/$defs/GapKind"
        },
        "description": {
          "type": "string"
        },
        "event": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "w": {
          "anyOf": [
            {
              "$ref": "#/$defs/W"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "related": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "関係する measure / 属性の参照"
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GapKind": {
      "enum": [
        "data_unavailable",
        "unanswered",
        "conflict",
        "deferred"
      ],
      "title": "GapKind",
      "type": "string"
    },
    "LagSpec": {
      "additionalProperties": false,
      "description": "段階を経て進む出来事（evolving）の、2 つの段階の間の時間（ラグ。#140）。\n\n生成器が段階の日時の列から `date_diff(unit, start, end)` で計算する（日・時の境目を数える）。\n終わりの段階にまだ達していない行は NULL。",
      "properties": {
        "start": {
          "description": "始まりの段階の When の ref",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "end": {
          "description": "終わりの段階の When の ref（start より後の段階）",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/LagUnit",
          "default": "day"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "LagSpec",
      "type": "object"
    },
    "LagUnit": {
      "enum": [
        "day",
        "hour"
      ],
      "title": "LagUnit",
      "type": "string"
    },
    "Level": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Level",
      "type": "string"
    },
    "MatrixColumn": {
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "w": {
          "$ref": "#/$defs/W"
        },
        "conformed": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label",
        "w",
        "conformed"
      ],
      "title": "MatrixColumn",
      "type": "object"
    },
    "MatrixRow": {
      "properties": {
        "event": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "fact_type": {
          "$ref": "#/$defs/FactType"
        },
        "grain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "measures": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dimensions": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        }
      },
      "required": [
        "event",
        "label",
        "fact_type",
        "grain",
        "priority",
        "impact",
        "effort",
        "measures",
        "dimensions"
      ],
      "title": "MatrixRow",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "description": "How many。fct の数値カラムになる。",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "description": "表示名（日本語）",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "aggregation": {
          "$ref": "#/$defs/Aggregation",
          "default": "sum"
        },
        "additivity": {
          "$ref": "#/$defs/Additivity",
          "default": "additive"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "単位（円、個 など）"
        },
        "non_additive_dimension": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "semi_additive のとき、足し上げできない When の ref（例: 残高の date）"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "集計する列。1 行を 1 件と数える件数（count）なら書かない"
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "unknown"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "定期的な状態（recurring）のイベントのとき、記録からの値の求め方"
        },
        "lag": {
          "anyOf": [
            {
              "$ref": "#/$defs/LagSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "段階を経て進む出来事（evolving）で、2 つの段階の間の時間を measure にするとき（source は書かない）"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "Measure",
      "type": "object"
    },
    "MetricFilter": {
      "additionalProperties": false,
      "description": "指標の絞り込み条件。Semantic Layer の filter に変換される。",
      "properties": {
        "ref": {
          "description": "`<dimension ref>.<attribute>` または縮退ディメンション名",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/FilterOperator"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      },
