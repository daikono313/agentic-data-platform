          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "column で表せない場合の SQL 式"
        }
      },
      "required": [
        "table"
      ],
      "title": "SourceRef",
