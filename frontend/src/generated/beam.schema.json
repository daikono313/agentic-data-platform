    },
    "StateMethod": {
      "description": "定期的な状態（recurring）の値の求め方（ADR 0008）。",
      "enum": [
        "last_value",
        "running_total"
      ],
      "title": "StateMethod",
      "type": "string"
    },
    "StateSpec": {
      "additionalProperties": false,
      "description": "定期的な状態（story_type: recurring）の measure を、記録からどう求めるか（#138、ADR 0008）。\n\nスナップショットは When の最小粒度（time_grain）の期間ごとに、粒度のキーから When を除いた\n区切り（店舗 × 商品など）で作る。記録の無い期間は前の期間の値を引き継ぐ。同じ時刻の記録は\n源泉の主キーの順に処理する。SQL は生成器が決まった形で作る（LLM にも人にも書かせない）。",
      "properties": {
        "method": {
          "$ref": "#/$defs/StateMethod",
          "description": "last_value（記録が時点の値そのもの）か running_total（増減を積み上げる）"
        },
        "reset": {
          "description": "running_total のとき、値を数え直した数に置き換える行の条件（例: movement_type が count の棚卸）。最初のこの行より前の期間は値を出さない",
          "items": {
            "$ref": "#/$defs/MetricFilter"
          },
          "type": "array"
        }
      },
      "required": [
        "method"
      ],
      "title": "StateSpec",
      "type": "object"
    },
    "StoryType": {
