        "type": {
          "$ref": "#/$defs/MetricType",
          "default": "simple"
        },
        "event": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "measure": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "simple / cumulative のとき"
        },
        "numerator": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ratio のとき（metric 名）"
        },
        "denominator": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ratio のとき（metric 名）"
        },
        "expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "derived のとき。他の metric 名を使った四則演算のみ"
        },
        "window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cumulative のとき（例: '7 days'）。無ければ全期間の累計"
