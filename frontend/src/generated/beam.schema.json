          "default": null,
          "description": "絞り込み条件の日本語の説明"
        },
        "filters": {
          "description": "絞り込み条件（すべて AND）。生成に使う",
          "items": {
            "$ref": "#/$defs/MetricFilter"
          },
          "type": "array"
        },
        "group_by": {
          "description": "`<dimension ref>.<attribute>`、縮退ディメンション名、または時間軸 `<When ref>.<day|week|month|quarter|year>` の一覧",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus",
          "default": "draft"
        }
      },
      "required": [
        "name",
        "label",
        "question",
        "framed_question",
        "event"
      ],
      "title": "MetricRequest",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "draft",
