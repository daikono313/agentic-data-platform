    "MetricRequest": {
      "additionalProperties": false,
      "description": "「How many ○○ by △△」の形にした指標の要求。Semantic Layer の metric になる。",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "question": {
          "description": "ユーザーの元の言葉",
          "type": "string"
        },
        "framed_question": {
          "description": "How many の形に言い換えた問い",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
