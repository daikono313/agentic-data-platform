{
  "name": "adp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:types": "cd ../backend && uv run python -m adp.beam.schema ../frontend/src/generated/beam.schema.json && uv run python -m adp.beam.demo ../frontend/src/demo/sales_by_store.json && cd ../frontend && json2ts -i src/generated/beam.schema.json -o src/generated/beam.ts --unreachableDefinitions --no-additionalProperties --bannerComment '/* backend の adp.beam から生成。手で編集しない（pnpm gen:types） */'"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "4",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "25",
    "json-schema-to-typescript": "15.0.4",
    "tailwindcss": "4",
    "tw-animate-css": "1.2.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "3"
  }
}
